# Plantilla sin secretos: introducir los valores reales en Vercel, no en Git.
APP_NAME=CryptoDungeon
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=es
APP_URL=https://tu-proyecto.vercel.app
APP_KEY=

DB_CONNECTION=pgsql
# Copiar la URL pooled de Neon, incluido ?sslmode=require.
DB_URL=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# Usar una base o rama Neon distinta para Preview y Production.
# No crear archivos .env en Vercel: usar Environment Variables.
